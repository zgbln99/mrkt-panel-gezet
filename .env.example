# Konfiguracja dla wdrożenia w Dockerze (docker-compose.yml).
# Skopiuj do .env w tym katalogu:  cp .env.example .env
#
# Przy wdrożeniu bez Dockera (pm2/systemd) używa się server/.env — patrz
# server/.env.example.

# WYMAGANE — wygeneruj własny:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

JWT_EXPIRES_IN=7d

# Puste = frontend i API pod tą samą domeną (zalecane, patrz deploy/nginx.conf).
CLIENT_ORIGIN=

# Za nginx-em na hoście ruch przechodzi przez proxy Dockera i nginx-a.
TRUST_PROXY=2

BCRYPT_ROUNDS=12
LOG_REQUESTS=true
