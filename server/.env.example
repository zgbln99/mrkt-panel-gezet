# Port, na którym działa API
PORT=4000

# Sekret do podpisywania tokenów JWT — WYGENERUJ WŁASNY na produkcji, np.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=zmien-to-na-losowy-dlugi-ciag-znakow

# Czas ważności tokenu logowania
JWT_EXPIRES_IN=7d

# Ścieżka do pliku bazy SQLite
DB_PATH=./data/gezet.db

# Adres frontendu — do konfiguracji CORS (kilka adresów oddziel przecinkiem)
CLIENT_ORIGIN=http://localhost:5173
