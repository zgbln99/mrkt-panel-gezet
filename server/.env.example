# ─────────────────────────────────────────────────────────────────────────
#  Konfiguracja backendu. Skopiuj do .env i uzupełnij:  cp .env.example .env
#  Plik .env NIE trafia do repozytorium (jest w .gitignore).
# ─────────────────────────────────────────────────────────────────────────

# Tryb pracy. Na serwerze produkcyjnym ZAWSZE "production" — włącza HSTS,
# wyłącza szczegółowe komunikaty błędów i przyspiesza Express.
NODE_ENV=production

# Port, na którym nasłuchuje API.
PORT=4000

# Interfejs nasłuchu. 127.0.0.1 = wyłącznie połączenia lokalne (nginx),
# czyli API nie jest wystawione bezpośrednio do internetu.
# Ustaw 0.0.0.0 tylko w kontenerze albo gdy świadomie wystawiasz port.
HOST=127.0.0.1

# Sekret do podpisywania tokenów JWT. WYMAGANY, min. 32 znaki.
# Wygeneruj własny:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Zmiana tej wartości unieważnia wszystkie aktywne sesje.
JWT_SECRET=

# Jak długo ważny jest token logowania (np. 12h, 7d, 30d).
JWT_EXPIRES_IN=7d

# Ścieżka do pliku bazy SQLite (katalog powstanie automatycznie).
DB_PATH=./data/gezet.db

# Dozwolone adresy frontendu dla CORS, po przecinku.
# ZOSTAW PUSTE, jeśli frontend jest serwowany z tej samej domeny co API
# (typowe wdrożenie za nginx-em) — wtedy żądania cross-origin są odcięte.
# Wypełnij tylko przy osobnej domenie frontendu, np.:
#   CLIENT_ORIGIN=https://marketing.twoja-domena.pl
CLIENT_ORIGIN=

# Liczba warstw proxy przed aplikacją. Za nginx-em: 1.
# Bez tego rate-limit widzi wszystkie żądania jako jeden adres IP.
TRUST_PROXY=1

# Koszt hashowania bcrypt (10–15). Wyżej = wolniejsze łamanie haseł,
# ale też wolniejsze logowanie. 12 to rozsądny kompromis.
BCRYPT_ROUNDS=12

# Ile zgłoszeń pobiera panel w jednym zapytaniu.
REQUESTS_PAGE_SIZE=200

# Logowanie żądań HTTP do stdout (pm2/journalctl/docker logs).
LOG_REQUESTS=true

# Zgoda na serwowanie aplikacji po zwykłym HTTP (bez certyfikatu).
# Ustawiaj TYLKO na czas, gdy HTTPS jeszcze nie działa: hasła jadą wtedy
# otwartym tekstem. Wyłącza HSTS i CSP upgrade-insecure-requests — bez tego
# przeglądarka próbowałaby pobrać pliki aplikacji po HTTPS i pokazałaby
# pustą stronę.
# ALLOW_INSECURE_HTTP=true

# Powiadomienia push na telefony (aplikacja mobilna z katalogu mobile/).
# Wyłączenie nie psuje niczego innego — powiadomienia w aplikacji i w panelu
# webowym działają niezależnie.
PUSH_ENABLED=true

# ── Firebase Cloud Messaging (zalecane) ────────────────────────────────
# Klucz konta usługi z Firebase:
#   Konsola Firebase → Ustawienia projektu → Konta usługi
#   → Wygeneruj nowy klucz prywatny  (plik JSON)
#
# Wgraj plik na serwer POZA katalogiem aplikacji i ogranicz uprawnienia:
#   sudo install -o gezet -g gezet -m 600 klucz.json /etc/gezet/fcm.json
# a następnie wskaż go tutaj:
# FCM_SERVICE_ACCOUNT=/etc/gezet/fcm.json
#
# Alternatywnie cała zawartość pliku w jednej linii (np. w kontenerze):
# FCM_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}
#
# Bez tego klucza powiadomienia idą przez darmowy przekaźnik Expo — działa
# od razu, ale treść powiadomień przechodzi wtedy przez serwery firmy trzeciej.

# Adres przekaźnika Expo. Zmieniaj tylko, jeśli używasz własnego pośrednika.
# PUSH_ENDPOINT=https://exp.host/--/api/v2/push/send
